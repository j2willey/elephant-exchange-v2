# Caddy sits in front of the app on the droplet: it gets and renews the HTTPS certificate,
# redirects http to https, and passes everything (Socket.IO's websockets included) through to the app.
# DOMAIN comes from .env; "localhost" gives a locally trusted certificate for trying it out.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Generous enough for a phone photo once Photos arrive; the app sets its own, tighter limits.
	request_body {
		max_size 20MB
	}

	# Caddy sets X-Forwarded-For to the address it saw (TRUST_PROXY=1 tells the app to believe it).
	reverse_proxy app:3000
}
