# Copy to .env on the droplet (never commit .env).

# Every `docker compose` command in this folder (scripts/backup.sh too) uses both files.
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# The image to run: the commit scripts/deploy.sh last shipped (it sets this). To roll back, set an earlier one.
TAG=

# The domain people open. Its DNS lives in Cloudflare (proxied, SSL mode Full); ww-edge routes it here.
DOMAIN=elephantexchange.app

# Who may use the admin page (/admin): your sign-in email; comma-separated for more than one.
ADMIN_EMAILS=

# From resend.com (API Keys). Leave empty to write sign-in links to the log instead of emailing them.
RESEND_API_KEY=
# An address on the domain you verified in Resend.
MAIL_FROM=Elephant Exchange <signin@elephantexchange.app>
