# Copy to .env on the droplet (never commit .env). Used by compose.prod.yaml.

# The domain people open; its DNS A record must point at the droplet before Caddy can get a certificate.
DOMAIN=swap.example.com

# From resend.com (API Keys). Leave empty to write sign-in links to the log instead of emailing them.
RESEND_API_KEY=
# An address on the domain you verified in Resend.
MAIL_FROM=Elephant Exchange <signin@swap.example.com>
