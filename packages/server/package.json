    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.4"
  },
  "dependencies": {
    "@elephant/rules": "0.0.0",
    "@hono/node-server": "2.1.6",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  }
}
